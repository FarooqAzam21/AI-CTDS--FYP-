# Supabase project settings (safe to expose in a browser build)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Set this in Vercel to the canonical production dashboard URL.  Local and
# preview deployments fall back to their current browser origin.
VITE_AUTH_REDIRECT_URL=https://YOUR_APP.vercel.app
